# ============================================================================
#  e-Pili Bomba Kunak — security response headers
#
#  WHERE THIS FILE GOES
#    In the SAME FOLDER as index.html, named exactly "_headers"
#    (no .txt, no extension at all).
#
#    If index.html is at the repo root:        /_headers
#    If index.html is inside public/:          /public/_headers
#
#    Cloudflare does not serve this file to visitors — it reads it and
#    applies these headers to every response.
#
#  NOTE ON MAINTENANCE
#    geolocation=(self) is required by the "Guna Lokasi Saya" button in
#    Tambah Pili. Setting it back to geolocation=() silently disables that
#    button with no error message.
#
#    The Content-Security-Policy below lists the exact origins this app
#    loads from. If you ever add a new CDN, font, or map tile provider,
#    it MUST be added here or the browser will silently block it.
# ============================================================================

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://isxfhocfkjamjchmicwq.supabase.co; connect-src 'self' https://isxfhocfkjamjchmicwq.supabase.co wss://isxfhocfkjamjchmicwq.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
