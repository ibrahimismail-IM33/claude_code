# Dev tooling only. Nothing in here is ever published — publish-to-site.yml
# copies index.html, _headers and vendor/ and nothing else, and the app's
# runtime libraries are self-hosted in vendor/ by deliberate decision.
node_modules/

# Playwright leftovers
test-results/
playwright-report/

# Build output from the V2 migration (docs/V2-ROADMAP.md). Generated by
# `npx vite build` and never committed: the publish gate exists so officers get
# a bundle built from reviewed source, not one that happened to be lying around.
# This branch is V1 and does not build at all — the entry is here because a
# `git add -A` run after a V2 build once swept dist/ into a V1 commit.
dist/
