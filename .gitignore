# Dev tooling only. Nothing in here is ever published — publish-to-site.yml
# copies index.html, _headers and vendor/ and nothing else, and the app's
# runtime libraries are self-hosted in vendor/ by deliberate decision.
node_modules/

# Playwright leftovers
test-results/
playwright-report/

# V2 build output. Generated by `npx vite build` from v2/ — see
# docs/V2-ROADMAP.md. Never commit it: the whole point of the publish gate is
# that officers get a bundle built from reviewed source, not one someone had
# lying around locally.
dist/
